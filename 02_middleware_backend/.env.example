# ---------- Servidor ----------
PORT=3000
FRONTEND_URL=http://localhost:5173
# Obligatorio en producción (NODE_ENV=production). En desarrollo se genera uno temporal.
JWT_SECRET=
# Credenciales del panel de Finanzas (RF-12)
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Base de datos ----------
DB_USER=
DB_PASSWORD=
DB_NAME=bova_payments_db
DB_HOST=localhost
DB_PORT=5432

# ---------- Cadena de bloques ----------
# Local: http://127.0.0.1:8545 (chainId 31337) | Polygon Amoy: URL del proveedor (chainId 80002)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
TOKEN_ADDRESS=
# Bloque en que se desplegó el contrato (lo imprime scripts/deploy.js)
DEPLOY_BLOCK=0
# Clave de la cuenta operadora que registra tarifas. Obligatoria fuera de la red local.
OPERATOR_PRIVATE_KEY=
# Confirmaciones exigidas antes de procesar un pago (por defecto 0 en local, 5 en otras redes)
CONFIRMATIONS=
MAX_BLOCK_RANGE=2000
POLL_INTERVAL_MS=3000

# ---------- Tipo de cambio ----------
EXCHANGE_RATE_URL=https://api.factura.bo/ExchangeRate
EXCHANGE_RATE_TIMEOUT_MS=4000
QUOTE_TTL_MINUTES=15

# ---------- Núcleo de reservas ----------
# Vacío: núcleo simulado del prototipo. Con URL: POST autenticado con CORE_TOKEN.
CORE_WEBHOOK_URL=
CORE_TOKEN=
