<mxfile host="drawio"><diagram name="Figura 63"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Ownable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;OpenZeppelin · onlyOwner&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#7F8C9D;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="0" width="190" height="64" as="geometry"/></mxCell><mxCell id="v3" value="&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ReentrancyGuard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;OpenZeppelin · nonReentrant&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#7F8C9D;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="190" height="64" as="geometry"/></mxCell><mxCell id="v4" value="«contract» BoAPayments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="540" height="34" as="geometry"/></mxCell><mxCell id="v5" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Estado&lt;/i&gt;&lt;br&gt;+ usdtToken : IERC20 {inmutable}&lt;br&gt;+ billeteraRecaudadora : address&lt;br&gt;+ operador : address&lt;br&gt;− tarifaPorPnr : mapping(bytes32 ⇒ Tarifa)&lt;br&gt;− pnrPagados : mapping(bytes32 ⇒ bool)&lt;br&gt;− LONGITUD_MAXIMA_PNR : uint256 = 10" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="144" width="540" height="128" as="geometry"/></mxCell><mxCell id="v6" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Cobro&lt;/i&gt;&lt;br&gt;+ registrarTarifa(pnr, monto, venceEn)   «soloOperador»&lt;br&gt;+ pagarBoleto(pnr)   «nonReentrant»" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EEF5EE;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="272" width="540" height="58" as="geometry"/></mxCell><mxCell id="v7" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Consultas&lt;/i&gt;&lt;br&gt;+ verificarPago(pnr) : bool&lt;br&gt;+ consultarTarifa(pnr) : (monto, venceEn)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="540" height="58" as="geometry"/></mxCell><mxCell id="v8" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Administración (solo el propietario)&lt;/i&gt;&lt;br&gt;+ actualizarBilleteraRecaudadora(nueva)   «onlyOwner»&lt;br&gt;+ actualizarOperador(nuevo)   «onlyOwner»&lt;br&gt;+ rescatarTokens(token, destino, monto)   «onlyOwner»&lt;br&gt;− _clave(pnr) : bytes32   (valida de 1 a 10 caracteres)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F7F7FB;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="388" width="540" height="92" as="geometry"/></mxCell><mxCell id="v9" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Eventos&lt;/i&gt;&lt;br&gt;TarifaRegistrada(pnr, monto, venceEn)&lt;br&gt;PagoConfirmado(cliente, pnr, monto, timestamp)&lt;br&gt;BilleteraRecaudadoraActualizada · OperadorActualizado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="540" height="76" as="geometry"/></mxCell><mxCell id="v10" value="&lt;i style=&quot;color:#5B6B7F&quot;&gt;Errores personalizados&lt;/i&gt;&lt;br&gt;PnrSinTarifa · PnrYaPagado · CotizacionVencida · MontoInvalido&lt;br&gt;VencimientoInvalido · PnrInvalido · SoloOperador · DireccionInvalida" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FDF3F3;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="556" width="540" height="60" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeColor=#404040;exitX=0.28;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v4" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeColor=#404040;exitX=0.73;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v4" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v13" value="&lt;i&gt;«struct»&lt;/i&gt; &lt;b&gt;Tarifa&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;+ monto : uint256&lt;br&gt;+ venceEn : uint64" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="200" height="78" as="geometry"/></mxCell><mxCell id="v14" value="&lt;i&gt;«interface»&lt;/i&gt; &lt;b&gt;IERC20&lt;/b&gt; (USDT)&lt;hr style=&quot;margin:3px 0&quot;&gt;+ approve(spender, monto)&lt;br&gt;+ transferFrom(de, a, monto)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="200" height="84" as="geometry"/></mxCell><mxCell id="v15" value="&lt;i&gt;«library»&lt;/i&gt; &lt;b&gt;SafeERC20&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;+ safeTransferFrom(...)&lt;br&gt;+ safeTransfer(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="200" height="84" as="geometry"/></mxCell><mxCell id="v16" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="540" height="506" as="geometry"/></mxCell><mxCell id="e17" value="1 · 0..*" style="html=1;strokeColor=#404040;fontColor=#303030;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;exitX=1;exitY=0.196;entryX=0;entryY=0.5;" edge="1" parent="1" source="v16" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="«usa»" style="html=1;strokeColor=#404040;fontColor=#303030;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;endArrow=open;dashed=1;exitX=1;exitY=0.458;entryX=0;entryY=0.5;" edge="1" parent="1" source="v16" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="«usa»" style="html=1;strokeColor=#404040;fontColor=#303030;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;endArrow=open;dashed=1;exitX=1;exitY=0.715;entryX=0;entryY=0.5;" edge="1" parent="1" source="v16" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="Secuencia de pagarBoleto(pnr): verificaciones, efectos e interacción" style="text;html=1;align=left;fontStyle=1;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="656" width="800" height="24" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;1. Verificaciones&lt;/b&gt;&lt;br&gt;La tarifa está registrada&lt;br&gt;(PnrSinTarifa)&lt;br&gt;La reserva no fue pagada&lt;br&gt;(PnrYaPagado)&lt;br&gt;La cotización está vigente&lt;br&gt;(CotizacionVencida)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#C08A47;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="686" width="240" height="130" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;2. Efectos&lt;/b&gt;&lt;br&gt;Marca la reserva&lt;br&gt;como pagada antes de&lt;br&gt;mover los fondos&lt;br&gt;(pnrPagados = true)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF5EE;strokeColor=#4C9A6A;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="686" width="240" height="130" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#404040;strokeWidth=2;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="&lt;b&gt;3. Interacción&lt;/b&gt;&lt;br&gt;Transfiere los USDT del&lt;br&gt;pasajero a la billetera&lt;br&gt;recaudadora (SafeERC20)&lt;br&gt;y emite PagoConfirmado" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3EAF4;strokeColor=#5B7BA6;fontColor=#1D2429;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="686" width="240" height="130" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#404040;strokeWidth=2;" edge="1" parent="1" source="v22" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>