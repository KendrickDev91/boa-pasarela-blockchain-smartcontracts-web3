<mxfile host="drawio"><diagram name="Contrato BoAPayments"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«contract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BoAPayments&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:5px;&quot;&gt;+ usdtToken : IERC20 {readOnly}&lt;br&gt;+ billeteraRecaudadora : address&lt;br&gt;+ operador : address&lt;br&gt;- tarifaPorPnr : mapping(bytes32 =&amp;gt; Tarifa)&lt;br&gt;- pnrPagados : mapping(bytes32 =&amp;gt; bool)&lt;br&gt;- LONGITUD_MAXIMA_PNR : uint256 = 10 {constant}&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:5px;&quot;&gt;«modifier» soloOperador() · onlyOwner() · nonReentrant()&lt;br&gt;+ registrarTarifa(pnr : string, monto : uint256, venceEn : uint64) «soloOperador»&lt;br&gt;+ pagarBoleto(pnr : string) «nonReentrant»&lt;br&gt;+ verificarPago(pnr : string) : bool&lt;br&gt;+ consultarTarifa(pnr : string) : (uint256, uint64)&lt;br&gt;+ actualizarBilleteraRecaudadora(nueva : address) «onlyOwner»&lt;br&gt;+ actualizarOperador(nuevo : address) «onlyOwner»&lt;br&gt;+ rescatarTokens(token : address, destino : address, monto : uint256) «onlyOwner»&lt;br&gt;- _clave(pnr : string) : bytes32&lt;br&gt;«event» TarifaRegistrada(pnr, monto, venceEn)&lt;br&gt;«event» PagoConfirmado(cliente, pnr, monto, timestamp)&lt;br&gt;«error» PnrSinTarifa · PnrYaPagado · CotizacionVencida · MontoInvalido&lt;br&gt;«error» VencimientoInvalido · PnrInvalido · SoloOperador · DireccionInvalida&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="520" height="354" as="geometry"/></mxCell><mxCell id="c2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IERC20&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:5px;&quot;&gt;+ approve(spender : address, monto : uint256) : bool&lt;br&gt;+ transferFrom(de : address, a : address, monto : uint256) : bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="444" width="520" height="82" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;pagarBoleto(pnr)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Verificaciones&lt;/b&gt;&lt;br&gt;1. La tarifa del localizador está registrada (PnrSinTarifa).&lt;br&gt;2. El localizador no fue pagado (PnrYaPagado).&lt;br&gt;3. La cotización está vigente (CotizacionVencida).&lt;br&gt;&lt;br&gt;&lt;b&gt;Efectos&lt;/b&gt;&lt;br&gt;4. pnrPagados[clave] = true.&lt;br&gt;&lt;br&gt;&lt;b&gt;Interacción&lt;/b&gt;&lt;br&gt;5. safeTransferFrom(pasajero, billeteraRecaudadora, monto).&lt;br&gt;6. Emite PagoConfirmado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#404040;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="360" height="250" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#595959;exitX=0;exitY=0.5;entryX=1;entryY=0.45;" edge="1" parent="1" source="c3" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="safeTransferFrom (SafeERC20)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>